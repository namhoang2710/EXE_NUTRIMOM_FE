{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/api(?:/.*)?$", "status": 404 },
    {
      "src": "^/assets/.+-[A-Za-z0-9_-]{8,}\\.[a-z0-9]+$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(?:index\\.html)?$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    }
  ]
}
